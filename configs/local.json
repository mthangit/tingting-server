  "api": {
    "baseUrl": "http://127.0.0.1:8080",
    "endpoints": {
      "config.bootstrap": {
        "method": "GET",
        "path": "/v1/bootstrap"
      },
      "auth.google": {
        "method": "POST",
        "path": "/v1/auth/google"
      },
      "auth.refresh": {
        "method": "POST",
        "path": "/v1/auth/refresh"
      },
      "auth.logout": {
        "method": "POST",
        "path": "/v1/auth/logout"
      },
      "me.get": {
        "method": "GET",
        "path": "/v1/me"
      },
      "sync.push": {
        "method": "POST",
        "path": "/v1/sync/push",
        "timeoutMs": 20000
      },
      "sync.pull": {
        "method": "GET",
        "path": "/v1/sync/pull"
      }
    }
  },
  "features": {
    "sync": true,
    "signInWithGoogle": true,
    "csvExport": false,
    "syncRawNotificationText": false
  },
  "sync": {
    "intervalSeconds": 900,
    "debounceSeconds": 5,
    "pushBatchSize": 200,
    "pullPageSize": 500
  },
