# Chép thành .env rồi điền giá trị thật. .env không được commit (có trong .gitignore).
# Trên Cloud Run, đặt các biến này trong phần cấu hình service, không dùng file.

# Cổng chạy trên máy. Cloud Run tự đặt PORT.
PORT=8080

# Chọn một trong hai:
# 1) Đọc config từ file, không cần database.
TING_CONFIG_FILE=configs/local.json
# 2) Postgres trên Neon. Có giá trị này thì bỏ TING_CONFIG_FILE ở trên.
# DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/ting?sslmode=require

# Domain mà config được phép trỏ tới, phân cách bằng dấu phẩy.
TING_ALLOWED_API_HOSTS=*.run.app,localhost,127.0.0.1

# Domain chứa logo nguồn tiền (bucket R2 public).
TING_ALLOWED_LOGO_HOSTS=*.r2.dev

# Đăng nhập Google (cần DATABASE_URL). Không đặt thì server tắt đăng nhập.
# OAuth client ID loại iOS tạo trên Google Cloud Console, phân cách bằng dấu phẩy nếu nhiều.
# TING_GOOGLE_CLIENT_IDS=1234567890-xxxx.apps.googleusercontent.com
# Khoá ký access token, ít nhất 32 ký tự. Tạo bằng: openssl rand -hex 32
# TING_JWT_SECRET=
